extends base

mixin reviewCardAccount(review)
  .reviews__card(data-review-id=`${review.id}` style='display: flex; flex-direction: column; align-items: center; padding: 4rem 3rem; background-color: #f7f7f7; border-radius: 5px; box-shadow: 0 1.5rem 4rem rgba(0,0,0,0.06);')
    .reviews__avatar(style='display: flex; flex-direction: column; align-items: center; margin-bottom: 2rem;')
      img.reviews__avatar-img(src=`${review.tour.imageCover.startsWith('http')?review.tour.imageCover:'/img/tours/'+review.tour.imageCover}`, alt=`${review.tour.name}` style='height: 8rem; width: 8rem; border-radius: 50%; margin-bottom: 1.5rem;')
      h6.reviews__user(style='font-size: 1.4rem; text-transform: uppercase; font-weight: 700; text-align: center;')= review.tour.name
    
    .review-display(style='display: flex; flex-direction: column; align-items: center; text-align: center; width: 100%; height: 100%;')
      p.reviews__text(style='font-size: 1.5rem; font-style: italic; margin-bottom: 2.5rem; flex-grow: 1;')= review.review
      .reviews__rating.ma-bt-sm(style='width:100%; display:flex; justify-content:center')
        each star in [1, 2, 3, 4, 5]
          svg.reviews__star(class=`reviews__star--${review.rating >= star ? 'active' : 'inactive'}`)
            use(xlink:href='/img/icons.svg#icon-star')
      button.btn.btn--small.btn--green.btn-edit-review(style='width: 100%; margin-top: 20px;') Edit Review
      button.btn.btn--small.btn--red.btn-delete-review(data-review-id=`${review.id}` style='width: 100%; margin-top: 20px; background-color:#F23D3D; color:white;') Delete Review

    .review-edit(style="display: none; width: 100%;")
      form.form.form--edit-review(data-review-id=`${review.id}`)
        .form__group
            label.form__label Rating
            .reviews__rating.reviews__rating--interactive(style='display: flex; gap: 0.5rem; justify-content: flex-start;')
                each star in [1, 2, 3, 4, 5]
                    svg.reviews__star(class=`reviews__star--${review.rating >= star ? 'active' : 'inactive'}`,data-rating=`${star}`)
                        use(xlink:href='/img/icons.svg#icon-star')
            input#rating(type='hidden', required, value='')
        .form__group.ma-bt-md
          label.form__label Review
          textarea.form__input.edit-text(rows='4', required)= review.review
        .form__group(style="display: flex; gap: 1rem;")
          button.btn.btn--small.btn--green.btn--save-edit(style='flex: 1;') Save
          button.btn.btn--small.btn--white.btn-cancel-edit(type="button" style='flex: 1;') Cancel

block content
  main.main(style='padding: 8rem 0;')
    div(style='max-width: 120rem; margin: 0 auto; padding: 0 3rem;')
      
      h2.heading-secondary.ma-bt-lg(style='text-align: center;') Your Reviews
      
      if reviews.length === 0
        div(style='text-align: center;')
          h2.error__emoji 😢
          .error__msg(style='font-size: 2rem;') You haven't written any reviews yet!
      else
        .reviews-grid(style='display: grid; grid-template-columns: repeat(auto-fit, minmax(32rem, 1fr)); gap: 4rem;')
          each review in reviews
            +reviewCardAccount(review)
    .modal.hidden(id="delete-modal" style="position: fixed; top: 0; left: 0; width: 100%; height: 100vh; background-color: rgba(0,0,0,0.5); z-index: 9999; display: flex; justify-content: center; align-items: center; opacity: 0; visibility: hidden; transition: all 0.3s;")
      .modal__content(style="background-color: #fff; padding: 4rem; border-radius: 5px; box-shadow: 0 2rem 4rem rgba(0,0,0,0.2); text-align: center; max-width: 50rem;")
        h2.heading-secondary.ma-bt-md Are you sure?
        p.ma-bt-lg(style="font-size: 1.6rem;") This action cannot be undone. Your review will be permanently deleted.
        div(style="display: flex; gap: 2rem; justify-content: center;")
          button.btn.btn--small.btn--white#btn-cancel-delete Cancel
          button.btn.btn--small.btn--red#btn-confirm-delete(style="background-color: #F23D3D; color: white;") Yes, Delete